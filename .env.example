# Copiá este archivo como .env y completá los valores.

# ── Inicio de sesión con Google (opcional) ──────────────────
# Si están vacíos, "Continuar con Google" funciona en modo demo.
# Se crean en https://console.cloud.google.com → APIs y servicios →
# Credenciales → ID de cliente de OAuth (aplicación web).
# En "URI de redireccionamiento autorizados" agregá GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ── Base de datos MySQL ─────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tienda_db
# true para ver en consola las consultas SQL
DB_LOG=false
# Zona horaria de las fechas (Argentina)
DB_TIMEZONE=-03:00
