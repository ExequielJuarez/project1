<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  // Muestra un dato de la tienda o un aviso visible si falta completarlo en el .env
  const d = (valor, variable) => valor
    ? valor
    : `<span class="legal__falta" title="Completar ${variable} en el .env">[completar ${variable}]</span>`;
%>

  <div class="contenedor">
    <nav class="migas migas--legal" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <span aria-current="page"><%= pagina.titulo %></span>
    </nav>
  </div>

  <main class="legal contenedor">
    <!-- Índice de páginas legales -->
    <aside class="legal__lateral" aria-label="Información legal">
      <p class="legal__lateral-titulo">Información legal</p>
      <ul class="legal__paginas">
        <% paginas.forEach(pg => { %>
          <li><a href="<%= pg.url %>" class="<%= pg.url === pagina.url ? 'activo' : '' %>" <%- pg.url === pagina.url ? 'aria-current="page"' : '' %>><%= pg.titulo %></a></li>
        <% }) %>
        <li><a href="/arrepentimiento" class="legal__arrepentimiento">Botón de arrepentimiento</a></li>
      </ul>
    </aside>

    <article class="legal__texto" id="textoLegal">
      <p class="legal__etiqueta">Información legal</p>
      <h1 class="legal__titulo"><%= pagina.titulo %></h1>
      <p class="legal__fecha">Última actualización: <%= actualizado %></p>

      <!-- Índice de la página (lo arma legal.js con los títulos) -->
      <nav class="legal__indice" id="indiceLegal" aria-label="En esta página" hidden>
        <p>En esta página</p>
        <ul></ul>
      </nav>

      <%- include('legal/' + pagina.archivo, { d }) %>
    </article>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/legal.js"></script>
</body>
</html>
