<%
  const formatoPrecio = (n) =>
    "$" + n.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titulo %> | (NOMBRE DE LA MARCA)</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/catalogo.css">
</head>
<body>

  <!-- ═════════════ BARRA DE ANUNCIOS ═════════════ -->
  <div class="anuncios" aria-label="Promociones">
    <div class="anuncios__pista">
      <% for (let i = 0; i < 2; i++) { %>
        <span>Envío gratis en compras desde $150.000</span>
        <span class="anuncios__sep">✦</span>
        <span>10% off pagando con transferencia</span>
        <span class="anuncios__sep">✦</span>
        <span>3 y 6 cuotas sin interés</span>
        <span class="anuncios__sep">✦</span>
        <span>Grabado personalizado en 48 hs</span>
        <span class="anuncios__sep">✦</span>
      <% } %>
    </div>
  </div>

  <!-- ═════════════ HEADER ═════════════ -->
  <header class="header" id="header">
    <div class="header__barra contenedor">
      <button class="icono-btn header__menu-btn" id="btnMenu" aria-label="Abrir menú" aria-expanded="false">
        <span class="hamburguesa"></span>
      </button>

      <form class="buscador" role="search" onsubmit="return false;">
        <input type="search" placeholder="Buscar productos…" aria-label="Buscar">
        <button type="submit" aria-label="Buscar">
          <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </form>

      <a href="/" class="logo" aria-label="Inicio">
        <span class="logo__marca">(LOGO)</span>
      </a>

      <div class="header__acciones">
        <button class="icono-btn header__buscar-movil" id="btnBuscarMovil" aria-label="Buscar">
          <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
        <a href="#" class="icono-btn" aria-label="Mi cuenta">
          <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </a>
        <button class="icono-btn carrito-btn" aria-label="Carrito">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 8h14l-1.2 12H6.2L5 8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 016 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
          <span class="carrito-btn__contador" id="contadorCarrito">0</span>
        </button>
      </div>
    </div>

    <div class="buscador-movil contenedor" id="buscadorMovil">
      <form class="buscador buscador--movil" role="search" onsubmit="return false;">
        <input type="search" placeholder="Buscar productos…" aria-label="Buscar">
        <button type="submit" aria-label="Buscar">
          <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </form>
    </div>

    <nav class="nav" id="nav" aria-label="Principal">
      <ul class="nav__lista contenedor">
        <li><a href="/">Inicio</a></li>
        <li class="nav__item--activo"><a href="/catalogo">Catálogo</a></li>
        <li><a href="#">Categoría 1</a></li>
        <li><a href="#">Categoría 2</a></li>
        <li><a href="#">Personalizados</a></li>
        <li><a href="#">Combos</a></li>
        <li><a href="#">Accesorios</a></li>
        <li><a href="#">Contacto</a></li>
      </ul>
    </nav>
  </header>

  <div class="overlay" id="overlay"></div>

  <!-- ═════════════ HERO / ENCABEZADO DE PÁGINA ═════════════ -->
  <section class="hero contenedor">
    <nav class="migas" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <span aria-current="page"><%= titulo %></span>
    </nav>
    <div class="hero__fila">
      <div>
        <h1 class="hero__titulo"><%= titulo %></h1>
        <p class="hero__texto">Piezas pensadas para durar. Elegí, personalizá y recibí en tu casa.</p>
      </div>
      <p class="hero__cantidad"><span id="cantidadVisible"><%= productos.length %></span> productos</p>
    </div>
  </section>

  <!-- ═════════════ CATÁLOGO ═════════════ -->
  <main class="catalogo contenedor">

    <!-- Barra de herramientas -->
    <div class="herramientas">
      <button class="btn-filtros" id="btnFiltros" aria-controls="filtros">
        <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Filtros
        <span class="btn-filtros__badge" id="badgeFiltros" hidden>0</span>
      </button>

      <div class="chips" id="chipsActivos"></div>

      <div class="herramientas__derecha">
        <div class="vista" role="group" aria-label="Cambiar vista">
          <button class="vista__btn" data-columnas="2" aria-label="2 columnas">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="1" y="1" width="6" height="14" fill="currentColor"/><rect x="9" y="1" width="6" height="14" fill="currentColor"/></svg>
          </button>
          <button class="vista__btn activo" data-columnas="3" aria-label="3 columnas">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="0.5" y="1" width="4" height="14" fill="currentColor"/><rect x="6" y="1" width="4" height="14" fill="currentColor"/><rect x="11.5" y="1" width="4" height="14" fill="currentColor"/></svg>
          </button>
          <button class="vista__btn" data-columnas="4" aria-label="4 columnas">
            <svg viewBox="0 0 16 16" width="14" height="14"><rect x="0" y="1" width="3" height="14" fill="currentColor"/><rect x="4.3" y="1" width="3" height="14" fill="currentColor"/><rect x="8.6" y="1" width="3" height="14" fill="currentColor"/><rect x="13" y="1" width="3" height="14" fill="currentColor"/></svg>
          </button>
        </div>

        <label class="orden">
          <span class="orden__label">Ordenar</span>
          <select id="orden">
            <option value="destacados">Destacados</option>
            <option value="precio-asc">Precio: menor a mayor</option>
            <option value="precio-desc">Precio: mayor a menor</option>
            <option value="nombre-asc">Nombre: A – Z</option>
          </select>
        </label>
      </div>
    </div>

    <div class="catalogo__cuerpo">

      <!-- Filtros (sidebar en PC / panel lateral en celular y tablet) -->
      <aside class="filtros" id="filtros" aria-label="Filtros">
        <div class="filtros__cabecera">
          <h2>Filtrar</h2>
          <button class="icono-btn" id="btnCerrarFiltros" aria-label="Cerrar filtros">
            <svg viewBox="0 0 24 24" width="20" height="20"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </div>

        <div class="acordeon abierto">
          <button class="acordeon__titulo" aria-expanded="true">Categoría <span class="acordeon__icono"></span></button>
          <div class="acordeon__contenido">
            <% categorias.forEach(cat => { %>
              <label class="check">
                <input type="checkbox" name="categoria" value="<%= cat.nombre %>">
                <span class="check__caja"></span>
                <span class="check__texto"><%= cat.nombre %></span>
                <span class="check__cantidad"><%= cat.cantidad %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="acordeon abierto">
          <button class="acordeon__titulo" aria-expanded="true">Color <span class="acordeon__icono"></span></button>
          <div class="acordeon__contenido acordeon__contenido--colores">
            <% colores.forEach(color => { %>
              <label class="color" title="<%= color.nombre %>">
                <input type="checkbox" name="color" value="<%= color.valor %>">
                <span class="color__muestra" style="--muestra: <%= color.hex %>"></span>
                <span class="color__nombre"><%= color.nombre %> <small>(<%= color.cantidad %>)</small></span>
              </label>
            <% }) %>
          </div>
        </div>

        <div class="acordeon">
          <button class="acordeon__titulo" aria-expanded="false">Precio <span class="acordeon__icono"></span></button>
          <div class="acordeon__contenido">
            <div class="rango">
              <label>
                <span>Mínimo</span>
                <input type="number" id="precioMin" placeholder="$ 0" min="0" inputmode="numeric">
              </label>
              <span class="rango__guion">—</span>
              <label>
                <span>Máximo</span>
                <input type="number" id="precioMax" placeholder="$ 999.999" min="0" inputmode="numeric">
              </label>
            </div>
          </div>
        </div>

        <div class="filtros__pie">
          <button class="btn btn--linea" id="btnLimpiar">Limpiar</button>
          <button class="btn btn--solido" id="btnAplicar">Ver resultados</button>
        </div>
      </aside>

      <!-- Grilla de productos -->
      <section class="grilla" id="grilla" data-columnas="3" aria-live="polite">
        <% productos.forEach((p, i) => { %>
          <article class="tarjeta"
                   data-nombre="<%= p.nombre %>"
                   data-categoria="<%= p.categoria %>"
                   data-color="<%= p.color %>"
                   data-precio="<%= p.precio %>"
                   data-orden="<%= i %>">
            <div class="tarjeta__media">
              <a href="#" class="tarjeta__imagen">
                <% if (p.etiqueta) { %>
                  <span class="tarjeta__etiqueta"><%= p.etiqueta %></span>
                <% } %>
                <span class="placeholder">
                  <span class="placeholder__texto">(IMAGEN)</span>
                </span>
                <span class="placeholder placeholder--alt">
                  <span class="placeholder__texto">(IMAGEN 2)</span>
                </span>
              </a>
              <button class="tarjeta__fav" aria-label="Agregar a favoritos">
                <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              </button>
              <button class="tarjeta__agregar" data-agregar>Agregar al carrito</button>
            </div>

            <div class="tarjeta__info">
              <p class="tarjeta__categoria"><%= p.categoria %></p>
              <h3 class="tarjeta__nombre"><a href="#"><%= p.nombre %></a></h3>
              <p class="tarjeta__precio"><%= formatoPrecio(p.precio) %></p>
              <p class="tarjeta__transferencia">
                <%= formatoPrecio(p.precio * (1 - descuentoTransferencia)) %> <span>con transferencia</span>
              </p>
            </div>
          </article>
        <% }) %>

        <div class="vacio" id="vacio" hidden>
          <p class="vacio__titulo">Sin resultados</p>
          <p>Probá quitando algunos filtros.</p>
          <button class="btn btn--linea" data-limpiar>Limpiar filtros</button>
        </div>
      </section>
    </div>

    <nav class="paginacion" aria-label="Paginación">
      <a href="#" class="paginacion__num activo">1</a>
      <a href="#" class="paginacion__num">2</a>
      <a href="#" class="paginacion__num">3</a>
      <a href="#" class="paginacion__sig">Siguiente →</a>
    </nav>
  </main>

  <!-- ═════════════ BENEFICIOS ═════════════ -->
  <section class="beneficios">
    <div class="contenedor beneficios__grilla">
      <div class="beneficio">
        <span class="beneficio__num">01</span>
        <h3>Envíos a todo el país</h3>
        <p>Gratis en compras desde $150.000.</p>
      </div>
      <div class="beneficio">
        <span class="beneficio__num">02</span>
        <h3>Cuotas sin interés</h3>
        <p>3 y 6 cuotas con todas las tarjetas.</p>
      </div>
      <div class="beneficio">
        <span class="beneficio__num">03</span>
        <h3>Personalizá tu pieza</h3>
        <p>Grabado a láser con tu diseño.</p>
      </div>
      <div class="beneficio">
        <span class="beneficio__num">04</span>
        <h3>Compra segura</h3>
        <p>Cambios y devoluciones sin vueltas.</p>
      </div>
    </div>
  </section>

  <!-- ═════════════ FOOTER ═════════════ -->
  <footer class="footer">
    <div class="contenedor footer__grilla">
      <div class="footer__marca">
        <span class="logo__marca logo__marca--footer">(LOGO)</span>
        <p>Breve descripción de la marca. Una o dos líneas que cuenten qué hacen y por qué.</p>
      </div>
      <div>
        <h4>Tienda</h4>
        <ul>
          <li><a href="#">Catálogo</a></li>
          <li><a href="#">Personalizados</a></li>
          <li><a href="#">Combos</a></li>
          <li><a href="#">Accesorios</a></li>
        </ul>
      </div>
      <div>
        <h4>Ayuda</h4>
        <ul>
          <li><a href="#">Envíos</a></li>
          <li><a href="#">Medios de pago</a></li>
          <li><a href="#">Cambios y devoluciones</a></li>
          <li><a href="#">Contacto</a></li>
        </ul>
      </div>
      <div>
        <h4>Newsletter</h4>
        <p>Novedades y descuentos, sin spam.</p>
        <form class="newsletter" onsubmit="return false;">
          <input type="email" placeholder="Tu email" aria-label="Email">
          <button type="submit">→</button>
        </form>
        <div class="footer__redes">
          <a href="#">(IG)</a>
          <a href="#">(FB)</a>
          <a href="#">(TK)</a>
        </div>
      </div>
    </div>
    <div class="contenedor footer__legal">
      <span>© <%= new Date().getFullYear() %> (NOMBRE DE LA MARCA). Todos los derechos reservados.</span>
      <span class="footer__pagos">(VISA) (MASTER) (MP)</span>
    </div>
  </footer>

  <!-- Botón flotante de WhatsApp -->
  <a href="#" class="whatsapp" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" width="24" height="24"><path d="M12 3a9 9 0 00-7.8 13.5L3 21l4.6-1.2A9 9 0 1012 3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.3-2.3l.8-1-1-2L9.5 8z" fill="currentColor"/></svg>
  </a>

  <!-- Aviso al agregar al carrito -->
  <div class="toast" id="toast" role="status"></div>

  <script src="/js/catalogo.js"></script>
</body>
</html>
