<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  const errorPassword = errores.password ? errores.password.msg : "";
%>

  <div class="contenedor">
    <nav class="migas migas--acceso" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <span aria-current="page">Iniciar sesión</span>
    </nav>
  </div>

  <!-- ═════════════ ACCESO ═════════════ -->
  <main class="acceso contenedor">

    <!-- Panel de marca (PC / tablet) -->
    <section class="acceso__panel" aria-label="Beneficios de tu cuenta">
      <span class="acceso__panel-imagen" aria-hidden="true">(IMAGEN DE MARCA)</span>

      <div class="acceso__panel-texto">
        <p class="acceso__etiqueta">Tu cuenta</p>
        <p class="acceso__frase">Todo lo que elegiste, <em>en un solo lugar.</em></p>

        <ul class="acceso__beneficios">
          <li><span>01</span> Seguí tus pedidos en tiempo real</li>
          <li><span>02</span> Guardá tus favoritos para después</li>
          <li><span>03</span> Comprá más rápido con tus datos guardados</li>
        </ul>
      </div>
    </section>

    <!-- Formulario -->
    <section class="acceso__form" aria-labelledby="tituloLogin">
      <h1 class="acceso__titulo" id="tituloLogin">Iniciar sesión</h1>
      <p class="acceso__bajada">Ingresá con tu email y contraseña.</p>

      <% if (errorGeneral) { %>
        <div class="aviso aviso--error" role="alert"><%= errorGeneral %></div>
      <% } %>

      <form action="/login" method="POST" id="formLogin" novalidate>
        <input type="hidden" name="volver" value="<%= volver %>">

        <%- include('partials/campo', { nombre: 'email', etiqueta: 'Email', tipo: 'email', placeholder: 'tu@email.com', attrs: 'autocomplete="email" autocapitalize="off" required autofocus' }) %>

        <div class="campo <%= errorPassword ? 'campo--error' : '' %>">
          <div class="campo__cabecera">
            <label class="campo__label" for="password">Contraseña</label>
            <a href="#" class="acceso__olvido" data-proximamente>¿La olvidaste?</a>
          </div>
          <div class="clave">
            <input class="campo__control" type="password" id="password" name="password"
                   autocomplete="current-password" required
                   aria-describedby="password-error password-mayus" <%- errorPassword ? 'aria-invalid="true"' : '' %>>
            <button type="button" class="clave__ver" id="verClave" aria-label="Mostrar contraseña" aria-pressed="false">
              <svg class="clave__ojo" viewBox="0 0 24 24" width="20" height="20"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
              <svg class="clave__ojo-tachado" viewBox="0 0 24 24" width="20" height="20"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 20L20 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </div>
          <p class="clave__mayus" id="password-mayus" hidden>Tenés activadas las mayúsculas</p>
          <p class="campo__error" id="password-error" aria-live="polite"><%= errorPassword %></p>
        </div>

        <label class="check-simple">
          <input type="checkbox" name="recordar" value="1" <%= datos.recordar ? 'checked' : '' %>>
          <span class="check-simple__caja"></span>
          Mantener la sesión iniciada
        </label>

        <button type="submit" class="btn btn--solido acceso__enviar" id="btnIngresar">Ingresar</button>
      </form>

      <div class="separador"><span>o</span></div>

      <div class="acceso__sociales">
        <button type="button" class="btn btn--linea" data-proximamente>(GOOGLE) Continuar con Google</button>
        <button type="button" class="btn btn--linea" data-proximamente>(APPLE) Continuar con Apple</button>
      </div>

      <p class="acceso__registro">
        ¿No tenés cuenta? <a href="#" data-proximamente>Creá una</a>
      </p>

      <!-- Solo para la maqueta: datos para probar -->
      <aside class="demo" aria-label="Usuario de prueba">
        <p class="demo__titulo">Usuario de prueba</p>
        <p><span>Email</span> demo@tienda.com</p>
        <p><span>Contraseña</span> Demo1234</p>
        <button type="button" class="demo__usar" id="usarDemo">Completar</button>
      </aside>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/login.js"></script>
</body>
</html>
