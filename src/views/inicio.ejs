<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  // Todo el contenido se edita desde Admin → Inicio (ver src/data/inicioEditable.js).
  // textoRico() escapa el texto y convierte *palabra* en cursiva.
  const c = contenido;
  const plano = (t) => String(t || "").replace(/\*/g, "");
  const romanos = ["I", "II", "III", "IV", "V", "VI"];
  const claseGaleria = ["galeria__item--alto", "", "galeria__item--ancho", "", "galeria__item--ultimo"];
  const chip = (src, oscuro) => `<span class="historia__chip ${oscuro ? 'historia__chip--oscuro' : ''}"><img src="${src}" alt="" loading="lazy"></span>`;
  const cifras = c.historia.cifras.filter((x) => x.texto);
  const pasos = c.proceso.pasos.filter((p) => p.titulo || p.texto);
%>

<main class="inicio">

  <!-- ═════════════ PORTADA ═════════════ -->
  <section class="portada" data-seccion="portada">
    <div class="contenedor portada__grilla">
      <div class="portada__texto">
        <% if (c.portada.etiqueta) { %>
          <p class="portada__etiqueta"><span class="portada__linea"></span><%- textoRico(c.portada.etiqueta) %></p>
        <% } %>
        <h1 class="portada__titulo">
          <% c.portada.titulo.split("\n").forEach((renglon) => { %>
            <span class="portada__renglon"><span><%- textoRico(renglon) %></span></span>
          <% }) %>
        </h1>
        <% if (c.portada.bajada) { %><p class="portada__bajada"><%- textoRico(c.portada.bajada) %></p><% } %>
        <div class="portada__acciones">
          <% if (c.portada.botonTexto) { %>
            <a href="<%= c.portada.botonLink || '/catalogo' %>" class="btn btn--solido"><%= c.portada.botonTexto %></a>
          <% } %>
          <% if (c.portada.secundarioTexto) { %>
            <a href="<%= c.portada.secundarioLink || '#' %>" class="portada__secundario"><%= c.portada.secundarioTexto %> <span aria-hidden="true"><%= String(c.portada.secundarioLink).startsWith('#') ? '↓' : '→' %></span></a>
          <% } %>
        </div>
      </div>

      <div class="portada__visual" data-parallax>
        <div class="portada__arco">
          <img src="<%= c.portada.imagen %>" alt="<%= plano(c.portada.titulo).replace(/\n/g, ' ') %>" width="480" height="540" fetchpriority="high">
        </div>

        <% if (c.portada.sello) { %>
          <!-- Sello giratorio -->
          <svg class="portada__sello" viewBox="0 0 200 200" aria-hidden="true">
            <defs><path id="circuloSello" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0"/></defs>
            <text><textPath href="#circuloSello" textLength="458" lengthAdjust="spacing"><%= c.portada.sello %></textPath></text>
            <circle cx="100" cy="100" r="34" fill="none" stroke="currentColor" stroke-width="1"/>
            <text x="100" y="108" text-anchor="middle" class="portada__sello-centro">(L)</text>
          </svg>
        <% } %>

        <figure class="portada__mini">
          <img src="<%= c.portada.miniImagen %>" alt="" width="400" height="500" loading="lazy">
          <% if (c.portada.miniTexto) { %><figcaption><%- c.portada.miniTexto.split("\n").map(textoRico).join("<br>") %></figcaption><% } %>
        </figure>
      </div>
    </div>

    <a href="<%= c.historia.visible ? '#historia' : '#contenido' %>" class="portada__bajar" aria-label="Seguir bajando"><span></span></a>
  </section>
  <span id="contenido"></span>

  <!-- ═════════════ CINTA ═════════════ -->
  <% if (c.cinta.visible && c.cinta.palabras) { %>
    <div class="cinta" aria-hidden="true" data-seccion="cinta">
      <div class="cinta__pista">
        <% for (let vuelta = 0; vuelta < 2; vuelta++) { %>
          <% c.cinta.palabras.split("\n").forEach((palabra) => { %><span><%- textoRico(palabra) %></span><i>✦</i><% }) %>
        <% } %>
      </div>
    </div>
  <% } %>

  <!-- ═════════════ HISTORIA ═════════════ -->
  <% if (c.historia.visible) { %>
    <section class="historia" id="historia" data-seccion="historia">
      <div class="contenedor">
        <% if (c.historia.etiqueta) { %><p class="seccion-etiqueta" data-revelar><%= c.historia.etiqueta %></p><% } %>
        <p class="historia__texto" data-revelar>
          <%- textoRico(c.historia.texto).replace("[foto1]", chip(c.historia.foto1, false)).replace("[foto2]", chip(c.historia.foto2, true)) %>
        </p>

        <% if (cifras.length) { %>
          <div class="cifras cifras--<%= cifras.length %>">
            <% cifras.forEach((x) => { %>
              <div class="cifra" data-revelar>
                <strong><span data-contar="<%= x.numero %>"><%= x.numero.toLocaleString('es-AR') %></span><%= x.sufijo %></strong>
                <span><%= x.texto %></span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ COLECCIONES ═════════════ -->
  <% if (c.colecciones.visible) { %>
    <section class="colecciones" data-seccion="colecciones">
      <div class="contenedor">
        <div class="seccion-cabecera">
          <div>
            <% if (c.colecciones.etiqueta) { %><p class="seccion-etiqueta" data-revelar><%= c.colecciones.etiqueta %></p><% } %>
            <h2 class="seccion-titulo" data-revelar><%- textoRico(c.colecciones.titulo) %></h2>
          </div>
          <div class="colecciones__flechas" aria-hidden="true">
            <button type="button" class="flecha" data-mover="-1" tabindex="-1">←</button>
            <button type="button" class="flecha" data-mover="1" tabindex="-1">→</button>
          </div>
        </div>
      </div>

      <ul class="colecciones__lista" id="colecciones">
        <% c.colecciones.items.forEach((col, i) => { %>
          <li class="coleccion coleccion--<%= col.fondo %>" data-revelar>
            <a href="<%= col.link || '/catalogo' %>" class="coleccion__link">
              <div class="coleccion__imagen">
                <img src="<%= col.imagen %>" alt="<%= col.nombre %>" width="400" height="500" loading="lazy">
              </div>
              <div class="coleccion__info">
                <span class="coleccion__num"><%= String(i + 1).padStart(2, '0') %></span>
                <h3 class="coleccion__nombre"><%= col.nombre %></h3>
                <p class="coleccion__frase"><%- textoRico(col.frase) %></p>
                <span class="coleccion__ver">Explorar <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <!-- ═════════════ PROCESO ═════════════ -->
  <% if (c.proceso.visible && pasos.length) { %>
    <section class="proceso" data-seccion="proceso">
      <div class="contenedor proceso__grilla">
        <div class="proceso__visual">
          <div class="proceso__marco">
            <% pasos.forEach((p, i) => { %>
              <img src="<%= p.imagen %>" alt="" class="proceso__img <%= i === 0 ? 'activa' : '' %>" data-paso-img="<%= i %>" loading="lazy">
            <% }) %>
            <span class="proceso__contador"><span id="pasoActual">01</span> / <%= String(pasos.length).padStart(2, '0') %></span>
          </div>
        </div>

        <div class="proceso__texto">
          <% if (c.proceso.etiqueta) { %><p class="seccion-etiqueta" data-revelar><%= c.proceso.etiqueta %></p><% } %>
          <h2 class="seccion-titulo" data-revelar><%- textoRico(c.proceso.titulo) %></h2>
          <ol class="pasos-taller">
            <% pasos.forEach((p, i) => { %>
              <li class="paso-taller <%= i === 0 ? 'activo' : '' %>" data-paso="<%= i %>" data-revelar>
                <span class="paso-taller__num"><%= String(i + 1).padStart(2, '0') %></span>
                <div>
                  <h3><%= p.titulo %></h3>
                  <p><%- textoRico(p.texto) %></p>
                </div>
              </li>
            <% }) %>
          </ol>
        </div>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ EL RITUAL ═════════════ -->
  <% if (c.ritual.visible) { %>
    <section class="ritual" data-seccion="ritual">
      <div class="contenedor ritual__grilla">
        <div class="ritual__cabecera">
          <% if (c.ritual.etiqueta) { %><p class="seccion-etiqueta seccion-etiqueta--clara" data-revelar><%= c.ritual.etiqueta %></p><% } %>
          <h2 class="seccion-titulo" data-revelar><%- textoRico(c.ritual.titulo) %></h2>
          <% if (c.ritual.bajada) { %><p class="ritual__bajada" data-revelar><%- textoRico(c.ritual.bajada) %></p><% } %>
        </div>

        <figure class="ritual__imagen" data-revelar>
          <img src="<%= c.ritual.imagen %>" alt="" width="640" height="520" loading="lazy">
        </figure>

        <ol class="consejos">
          <% c.ritual.consejos.filter((x) => x.titulo || x.texto).forEach((x, i) => { %>
            <li class="consejo" data-revelar>
              <span class="consejo__num"><%= romanos[i] %></span>
              <h3><%= x.titulo %></h3>
              <p><%- textoRico(x.texto) %></p>
            </li>
          <% }) %>
        </ol>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ PERSONALIZADOS ═════════════ -->
  <% if (c.personaliza.visible) { %>
    <section class="personaliza" data-seccion="personaliza">
      <div class="contenedor personaliza__grilla">
        <div class="personaliza__visual" data-revelar>
          <svg viewBox="0 0 400 500" class="personaliza__mate" role="img" aria-label="Vista previa del grabado">
            <image href="<%= c.personaliza.imagen %>" width="400" height="500" preserveAspectRatio="xMidYMax meet"/>
            <defs><path id="curvaGrabado" d="M122,322 Q200,338 278,322"/></defs>
            <text class="grabado grabado--clasica" id="grabadoTexto" text-anchor="middle">
              <textPath href="#curvaGrabado" startOffset="50%"><%= c.personaliza.ejemplo %></textPath>
            </text>
            <text class="grabado grabado--fecha" x="200" y="366" text-anchor="middle" id="grabadoDetalle">✦ ✦ ✦</text>
          </svg>
        </div>

        <div class="personaliza__texto">
          <% if (c.personaliza.etiqueta) { %><p class="seccion-etiqueta" data-revelar><%= c.personaliza.etiqueta %></p><% } %>
          <h2 class="seccion-titulo" data-revelar><%- textoRico(c.personaliza.titulo) %></h2>
          <% if (c.personaliza.bajada) { %><p class="personaliza__bajada" data-revelar><%- textoRico(c.personaliza.bajada) %></p><% } %>

          <form class="grabador" id="grabador" data-revelar>
            <label class="grabador__campo">
              <span>Texto a grabar</span>
              <input type="text" id="grabadoInput" maxlength="14" placeholder="<%= c.personaliza.ejemplo %>" data-ejemplo="<%= c.personaliza.ejemplo %>" autocomplete="off">
              <small><span id="grabadoCuenta">0</span>/14</small>
            </label>

            <fieldset class="grabador__estilos">
              <legend>Tipografía</legend>
              <label><input type="radio" name="tipografia" value="clasica" checked><span class="tipo tipo--clasica">Clásica</span></label>
              <label><input type="radio" name="tipografia" value="moderna"><span class="tipo tipo--moderna">Moderna</span></label>
              <label><input type="radio" name="tipografia" value="iniciales"><span class="tipo tipo--iniciales">Iniciales</span></label>
            </fieldset>

            <div class="grabador__acciones">
              <% if (c.personaliza.boton1Texto) { %><a href="<%= c.personaliza.boton1Link || '#' %>" class="btn btn--solido"><%= c.personaliza.boton1Texto %></a><% } %>
              <% if (c.personaliza.boton2Texto) { %><a href="<%= c.personaliza.boton2Link || '#' %>" class="btn btn--linea"><%= c.personaliza.boton2Texto %></a><% } %>
            </div>
          </form>
        </div>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ GALERÍA ═════════════ -->
  <% if (c.galeria.visible) { %>
    <section class="galeria" data-seccion="galeria">
      <div class="contenedor">
        <div class="seccion-cabecera">
          <div>
            <% if (c.galeria.etiqueta) { %><p class="seccion-etiqueta" data-revelar><%= c.galeria.etiqueta %></p><% } %>
            <h2 class="seccion-titulo" data-revelar><%- textoRico(c.galeria.titulo) %></h2>
          </div>
          <% if (c.galeria.redTexto) { %>
            <a href="<%= c.galeria.redLink || '#' %>" class="galeria__seguir" data-revelar><%= c.galeria.redTexto %> <span aria-hidden="true">→</span></a>
          <% } %>
        </div>

        <div class="galeria__grilla">
          <% c.galeria.fotos.forEach((f, i) => { %>
            <figure class="galeria__item <%= claseGaleria[i] %> galeria__item--<%= f.fondo %>" data-revelar>
              <img src="<%= f.imagen %>" alt="<%= f.texto %>" loading="lazy">
              <% if (f.texto) { %><figcaption><%= f.texto %></figcaption><% } %>
            </figure>
            <% if (i === 1) { %>
              <figure class="galeria__item galeria__item--frase" data-revelar>
                <blockquote><%- textoRico(c.galeria.frase) %></blockquote>
              </figure>
            <% } %>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ TESTIMONIOS ═════════════ -->
  <% if (c.testimonios.visible && c.testimonios.items.length) { %>
    <section class="testimonios" data-seccion="testimonios" aria-roledescription="carrusel" aria-label="Lo que dicen nuestros clientes">
      <div class="contenedor testimonios__caja">
        <% if (c.testimonios.etiqueta) { %><p class="seccion-etiqueta" data-revelar><%= c.testimonios.etiqueta %></p><% } %>
        <div class="testimonios__pista" id="testimonios" aria-live="polite">
          <% c.testimonios.items.forEach((t, i) => { %>
            <figure class="testimonio <%= i === 0 ? 'activo' : '' %>" data-testimonio="<%= i %>" <%= i === 0 ? '' : 'aria-hidden=true' %>>
              <blockquote><%- textoRico(t.texto) %></blockquote>
              <figcaption><strong><%= t.autor %></strong><% if (t.lugar) { %> · <%= t.lugar %><% } %></figcaption>
            </figure>
          <% }) %>
        </div>
        <% if (c.testimonios.items.length > 1) { %>
          <div class="testimonios__puntos" role="tablist">
            <% c.testimonios.items.forEach((t, i) => { %>
              <button type="button" class="<%= i === 0 ? 'activo' : '' %>" data-ir="<%= i %>" role="tab" aria-selected="<%= i === 0 %>" aria-label="Opinión <%= i + 1 %>"></button>
            <% }) %>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <!-- ═════════════ CIERRE ═════════════ -->
  <% if (c.cierre.visible) { %>
    <section class="cierre" data-seccion="cierre">
      <img src="/img/inicio/rama.svg" alt="" class="cierre__rama cierre__rama--izq" loading="lazy">
      <img src="/img/inicio/rama.svg" alt="" class="cierre__rama cierre__rama--der" loading="lazy">
      <div class="contenedor cierre__caja">
        <% if (c.cierre.etiqueta) { %><p class="seccion-etiqueta seccion-etiqueta--clara" data-revelar><%= c.cierre.etiqueta %></p><% } %>
        <h2 class="cierre__titulo" data-revelar><%- c.cierre.titulo.split("\n").map(textoRico).join("<br>") %></h2>
        <div class="cierre__acciones" data-revelar>
          <% if (c.cierre.botonTexto) { %><a href="<%= c.cierre.botonLink || '/catalogo' %>" class="btn btn--claro"><%= c.cierre.botonTexto %></a><% } %>
          <% if (c.cierre.secundarioTexto) { %><a href="<%= c.cierre.secundarioLink || '#' %>" class="cierre__link"><%= c.cierre.secundarioTexto %> →</a><% } %>
        </div>
      </div>
    </section>
  <% } %>

</main>

<%- include('partials/footer') %>
<script src="/js/inicio.js"></script>
</body>
</html>
