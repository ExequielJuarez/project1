<%- include('partials/head') %>
<%- include('partials/header') %>

<%
  const textos = {
    login: { titulo: 'Revisá tu email', boton: 'Entrar' },
    recuperar: { titulo: 'Revisá tu email', boton: 'Entrar y cambiar la contraseña' },
    registro: { titulo: 'Confirmá tu email', boton: 'Confirmar y crear mi cuenta' },
  }[motivo];
%>

  <div class="contenedor">
    <nav class="migas migas--acceso" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <span aria-current="page">Código</span>
    </nav>
  </div>

  <!-- ═════════════ INGRESAR CÓDIGO ═════════════ -->
  <main class="codigo contenedor">
    <section class="codigo__tarjeta" aria-labelledby="tituloVerificar">
      <span class="codigo__icono" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28"><rect x="5" y="11" width="14" height="9" rx="1" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M8 11V8a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </span>
      <h1 class="acceso__titulo" id="tituloVerificar"><%= textos.titulo %></h1>
      <p class="acceso__bajada">
        Te mandamos un código de 6 números a <strong><%= emailOculto %></strong>.
        Vence en <%= venceMin %> minutos. Si no lo ves, fijate en spam o promociones.
      </p>

      <% if (codigoDemo) { %>
        <div class="codigo__demo" role="note">
          <strong>Modo demostración</strong>
          Todavía no hay un email configurado (SMTP en el .env), así que el código no se envía.
          Tu código es <span class="codigo__demo-numero"><%= codigoDemo %></span>
        </div>
      <% } %>

      <% if (errorGeneral) { %>
        <div class="aviso aviso--error" role="alert"><%= errorGeneral %></div>
      <% } %>

      <form action="/verificar" method="POST" id="formVerificar" class="acceso__campos" novalidate>
        <label class="campo__label" for="codigo">Código</label>
        <input class="codigo__input" type="text" id="codigo" name="codigo" inputmode="numeric" pattern="[0-9]*"
               maxlength="6" autocomplete="one-time-code" placeholder="••••••" required autofocus aria-describedby="codigo-ayuda">
        <p class="codigo__ayuda" id="codigo-ayuda">Son 6 números.</p>
        <button type="submit" class="btn btn--solido acceso__enviar" id="btnVerificar"><%= textos.boton %></button>
      </form>

      <form action="/verificar/reenviar" method="POST" class="codigo__reenviar">
        <span>¿No te llegó?</span>
        <button type="submit" class="codigo__reenviar-btn" id="btnReenviar" data-espera="<%= esperaReenvio %>">Mandar otro código</button>
      </form>

      <p class="acceso__registro">
        <a href="<%= motivo === 'registro' ? '/registro' : '/login' %>">← Usar otro email</a>
      </p>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/verificar-codigo.js"></script>
</body>
</html>
