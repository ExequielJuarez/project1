<!-- ═════════════ BARRA DE ANUNCIOS ═════════════ -->
<div class="anuncios" aria-label="Promociones">
  <div class="anuncios__pista">
    <% for (let i = 0; i < 2; i++) { %>
      <span>Envío gratis en compras desde $150.000</span>
      <span class="anuncios__sep">✦</span>
      <span>10% off pagando con transferencia</span>
      <span class="anuncios__sep">✦</span>
      <span>3 y 6 cuotas sin interés</span>
      <span class="anuncios__sep">✦</span>
      <span>Grabado personalizado en 48 hs</span>
      <span class="anuncios__sep">✦</span>
    <% } %>
  </div>
</div>

<!-- ═════════════ HEADER ═════════════ -->
<header class="header" id="header">
  <div class="header__barra contenedor">
    <button class="icono-btn header__menu-btn" id="btnMenu" aria-label="Abrir menú" aria-expanded="false">
      <span class="hamburguesa"></span>
    </button>

    <form class="buscador" role="search" onsubmit="return false;">
      <input type="search" placeholder="Buscar productos…" aria-label="Buscar">
      <button type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </form>

    <a href="/" class="logo" aria-label="Inicio">
      <span class="logo__marca">(LOGO)</span>
    </a>

    <div class="header__acciones">
      <button class="icono-btn header__buscar-movil" id="btnBuscarMovil" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <% if (locals.usuarioLocal) { %>
        <div class="cuenta" id="cuenta">
          <button class="icono-btn cuenta__btn" id="cuentaBtn" aria-label="Mi cuenta" aria-expanded="false" aria-controls="cuentaMenu">
            <span class="cuenta__inicial"><%= usuarioLocal.nombre.charAt(0) %></span>
          </button>
          <div class="cuenta__menu" id="cuentaMenu" hidden>
            <p class="cuenta__hola">Hola, <strong><%= usuarioLocal.nombre %></strong></p>
            <p class="cuenta__email"><%= usuarioLocal.email %></p>
            <a href="#" class="cuenta__link" data-proximamente>Mis pedidos</a>
            <a href="#" class="cuenta__link" data-proximamente>Mis datos</a>
            <form action="/logout" method="POST">
              <button type="submit" class="cuenta__salir">Cerrar sesión</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <% const volverA = ['/login', '/'].includes(locals.currentPath) ? '' : '?volver=' + encodeURIComponent(currentPath); %>
        <a href="/login<%= volverA %>" class="icono-btn" aria-label="Iniciar sesión">
        <svg viewBox="0 0 24 24" width="20" height="20"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </a>
      <% } %>
      <a href="/carrito" class="icono-btn carrito-btn" aria-label="Carrito">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 8h14l-1.2 12H6.2L5 8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8V6a3 3 0 016 0v2" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        <span class="carrito-btn__contador" id="contadorCarrito"><%= locals.cantidadCarrito || 0 %></span>
      </a>
    </div>
  </div>

  <div class="buscador-movil contenedor" id="buscadorMovil">
    <form class="buscador buscador--movil" role="search" onsubmit="return false;">
      <input type="search" placeholder="Buscar productos…" aria-label="Buscar">
      <button type="submit" aria-label="Buscar">
        <svg viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </form>
  </div>

  <nav class="nav" id="nav" aria-label="Principal">
    <ul class="nav__lista contenedor">
      <li><a href="/">Inicio</a></li>
      <li class="<%= locals.navActivo === 'catalogo' ? 'nav__item--activo' : '' %>"><a href="/catalogo">Catálogo</a></li>
      <li><a href="#">Categoría 1</a></li>
      <li><a href="#">Categoría 2</a></li>
      <li><a href="#">Personalizados</a></li>
      <li><a href="#">Combos</a></li>
      <li><a href="#">Accesorios</a></li>
      <li><a href="#">Contacto</a></li>
    </ul>
  </nav>
</header>

<div class="overlay" id="overlay"></div>
