<article class="tarjeta"
         data-nombre="<%= p.nombre %>"
         data-categoria="<%= p.categoria %>"
         data-color="<%= p.color %>"
         data-precio="<%= p.precio %>"
         data-orden="<%= typeof i !== 'undefined' ? i : 0 %>">
  <div class="tarjeta__media">
    <a href="/producto/<%= p.id %>" class="tarjeta__imagen">
      <% if (p.etiqueta) { %>
        <span class="tarjeta__etiqueta"><%= p.etiqueta %></span>
      <% } %>
      <span class="placeholder">
        <span class="placeholder__texto">(IMAGEN)</span>
      </span>
      <span class="placeholder placeholder--alt">
        <span class="placeholder__texto">(IMAGEN 2)</span>
      </span>
    </a>
    <button class="tarjeta__fav" aria-label="Agregar a favoritos">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
    </button>
    <button class="tarjeta__agregar" data-agregar>Agregar al carrito</button>
  </div>

  <div class="tarjeta__info">
    <p class="tarjeta__categoria"><%= p.categoria %></p>
    <h3 class="tarjeta__nombre"><a href="/producto/<%= p.id %>"><%= p.nombre %></a></h3>
    <p class="tarjeta__precio"><%= formatoPrecio(p.precio) %></p>
    <p class="tarjeta__transferencia">
      <%= formatoPrecio(p.precio * (1 - descuentoTransferencia)) %> <span>con transferencia</span>
    </p>
  </div>
</article>
