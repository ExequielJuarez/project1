<%
  // Logo de Santiago Mates en vector (se ve nítido en cualquier tamaño).
  // Toma el color del texto que lo rodea (currentColor): marrón sobre fondo
  // claro, crema sobre fondo oscuro.
  //   variante: "horizontal" (encabezado) o "apilado" (pie de página)
  const variante = locals.variante || "horizontal";
  const clase = locals.clase || "";
%>
<% if (variante === "apilado") { %>
<svg class="logo-svg logo-svg--apilado <%= clase %>" viewBox="0 0 260 190" role="img" aria-label="Santiago Mates · La gran casa matera">
  <!-- Mate con bombilla -->
  <g transform="translate(104 6)">
    <path d="M24 40 Q22 33 30 31 L50 31 Q58 33 56 40 Q66 48 66 64 Q66 92 40 96 Q14 92 14 64 Q14 48 24 40 Z" fill="currentColor"/>
    <path d="M24 40 L56 40" stroke="var(--logo-fondo, transparent)" stroke-width="2.5"/>
    <path d="M44 34 L52 4 Q53 0 57 0 L64 1" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
  </g>
  <text x="130" y="148" text-anchor="middle" class="logo-svg__marca">Santiago<tspan class="logo-svg__marca--fuerte">Mates</tspan></text>
  <text x="130" y="176" text-anchor="middle" class="logo-svg__bajada">LA GRAN CASA MATERA</text>
</svg>
<% } else { %>
<svg class="logo-svg logo-svg--horizontal <%= clase %>" viewBox="0 0 300 70" role="img" aria-label="Santiago Mates · La gran casa matera">
  <g transform="translate(2 2) scale(0.66)">
    <path d="M24 40 Q22 33 30 31 L50 31 Q58 33 56 40 Q66 48 66 64 Q66 92 40 96 Q14 92 14 64 Q14 48 24 40 Z" fill="currentColor"/>
    <path d="M24 40 L56 40" stroke="var(--logo-fondo, transparent)" stroke-width="2.5"/>
    <path d="M44 34 L52 4 Q53 0 57 0 L64 1" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
  </g>
  <text x="54" y="40" class="logo-svg__marca">Santiago<tspan class="logo-svg__marca--fuerte">Mates</tspan></text>
  <text x="55" y="61" class="logo-svg__bajada">LA GRAN CASA MATERA</text>
</svg>
<% } %>
