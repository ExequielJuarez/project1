<!-- ═════════════ BENEFICIOS ═════════════ -->
<section class="beneficios">
  <div class="contenedor beneficios__grilla">
    <div class="beneficio">
      <span class="beneficio__num">01</span>
      <h3>Envíos a todo el país</h3>
      <p>Gratis en compras desde $150.000.</p>
    </div>
    <div class="beneficio">
      <span class="beneficio__num">02</span>
      <h3>Cuotas sin interés</h3>
      <p>3 y 6 cuotas con todas las tarjetas.</p>
    </div>
    <div class="beneficio">
      <span class="beneficio__num">03</span>
      <h3>Personalizá tu pieza</h3>
      <p>Grabado a láser con tu diseño.</p>
    </div>
    <div class="beneficio">
      <span class="beneficio__num">04</span>
      <h3>Compra segura</h3>
      <p>Cambios y devoluciones sin vueltas.</p>
    </div>
  </div>
</section>

<!-- ═════════════ FOOTER ═════════════ -->
<footer class="footer">
  <div class="contenedor footer__grilla">
    <div class="footer__marca">
      <img src="/img/marca/logo.png" alt="Santiago Mates · La gran casa matera" class="logo__img logo__img--footer" width="121" height="111">
      <p>Breve descripción de la marca. Una o dos líneas que cuenten qué hacen y por qué.</p>
    </div>
    <div>
      <h4>Tienda</h4>
      <ul>
        <li><a href="#">Catálogo</a></li>
        <li><a href="#">Personalizados</a></li>
        <li><a href="#">Combos</a></li>
        <li><a href="#">Accesorios</a></li>
      </ul>
    </div>
    <div>
      <h4>Ayuda</h4>
      <ul>
        <li><a href="#">Envíos</a></li>
        <li><a href="#">Medios de pago</a></li>
        <li><a href="#">Cambios y devoluciones</a></li>
        <li><a href="#">Contacto</a></li>
      </ul>
    </div>
    <div>
      <h4>Newsletter</h4>
      <p>Novedades y descuentos, sin spam.</p>
      <form class="newsletter" onsubmit="return false;">
        <input type="email" placeholder="Tu email" aria-label="Email">
        <button type="submit">→</button>
      </form>
      <div class="footer__redes">
        <a href="#">(IG)</a>
        <a href="#">(FB)</a>
        <a href="#">(TK)</a>
      </div>
    </div>
  </div>
  <div class="contenedor footer__legal">
    <span>© <%= new Date().getFullYear() %> Santiago Mates. Todos los derechos reservados.</span>
    <span class="footer__pagos">(VISA) (MASTER) (MP)</span>
  </div>
</footer>

<!-- Botón flotante de WhatsApp -->
<a href="#" class="whatsapp" aria-label="WhatsApp">
  <svg viewBox="0 0 24 24" width="24" height="24"><path d="M12 3a9 9 0 00-7.8 13.5L3 21l4.6-1.2A9 9 0 1012 3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8.5c0 3.5 3 6.5 6.5 6.5l1-1.5-2-1-1 .8c-1-.4-2-1.4-2.3-2.3l.8-1-1-2L9.5 8z" fill="currentColor"/></svg>
</a>

<!-- Aviso al agregar al carrito -->
<div class="toast" id="toast" role="status"></div>

<% if (locals.flash) { %>
  <div id="flash" data-mensaje="<%= flash %>" hidden></div>
<% } %>

<script src="/js/base.js"></script>
<% if (esAdmin(locals.usuarioLocal)) { %>
  <%- include('notificaciones-avisos') %>
<% } %>
