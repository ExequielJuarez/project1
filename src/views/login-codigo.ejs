<%- include('partials/head') %>
<%- include('partials/header') %>

<% const recuperar = motivo === "recuperar"; %>

  <div class="contenedor">
    <nav class="migas migas--acceso" aria-label="Ruta">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/login?volver=<%= encodeURIComponent(volver) %>">Iniciar sesión</a>
      <span>/</span>
      <span aria-current="page"><%= recuperar ? 'Recuperar cuenta' : 'Código por email' %></span>
    </nav>
  </div>

  <!-- ═════════════ PEDIR CÓDIGO ═════════════ -->
  <main class="codigo contenedor">
    <section class="codigo__tarjeta" aria-labelledby="tituloCodigo">
      <span class="codigo__icono" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28"><rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M3.5 6l8.5 7 8.5-7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
      </span>
      <h1 class="acceso__titulo" id="tituloCodigo"><%= recuperar ? '¿Olvidaste tu contraseña?' : 'Entrá con un código' %></h1>
      <p class="acceso__bajada">
        <%= recuperar
              ? 'Escribí el email de tu cuenta. Te mandamos un código para entrar y elegir una contraseña nueva.'
              : 'Sin contraseña: escribí tu email y te mandamos un código de 6 números para entrar.' %>
      </p>

      <%- include('partials/aviso-compra') %>

      <% if (!disponible) { %>
        <div class="aviso aviso--error" role="alert">Por ahora no podemos mandar códigos. Entrá con tu contraseña o con Google.</div>
      <% } %>

      <form action="/login/codigo" method="POST" id="formCodigo" class="acceso__campos" novalidate>
        <input type="hidden" name="volver" value="<%= volver %>">
        <input type="hidden" name="motivo" value="<%= motivo %>">

        <%- include('partials/campo', { nombre: 'email', etiqueta: 'Email', tipo: 'email', placeholder: 'tu@email.com', attrs: 'autocomplete="email" autocapitalize="off" maxlength="120" required autofocus' }) %>

        <button type="submit" class="btn btn--solido acceso__enviar" id="btnCodigo" <%= disponible ? '' : 'disabled' %>>Mandarme el código</button>
      </form>

      <p class="acceso__registro">
        <a href="/login?volver=<%= encodeURIComponent(volver) %>">← Volver a iniciar sesión</a>
        <span class="codigo__sep">·</span>
        <a href="/registro?volver=<%= encodeURIComponent(volver) %>">Crear una cuenta</a>
      </p>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/login-codigo.js"></script>
</body>
</html>
